<mujoco model="cola_g1_locomotion">
  <include file="g1/g1.xml"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"
          solver="Newton" cone="pyramidal" iterations="100" tolerance="1e-8"/>

  <statistic center="0 0 0.75" extent="2.2"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25"
               specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-18"/>
  </visual>

  <asset>
    <texture name="ground_checker" type="2d" builtin="checker"
             rgb1="0.18 0.20 0.23" rgb2="0.32 0.35 0.38"
             width="512" height="512"/>
    <material name="ground" texture="ground_checker" texrepeat="12 12"
              texuniform="true" reflectance="0.05" roughness="0.9"/>
  </asset>

  <worldbody>
    <light pos="1 -1 3" dir="-0.2 0.2 -1" directional="true"/>
    <geom name="ground" type="plane" size="4 4 0.1" material="ground"
          contype="1" conaffinity="1" condim="3"
          friction="1.2 0.000 0.0000" solref="0.002 1"
          solimp="0.99 0.999 0.0001"/>
  </worldbody>
</mujoco>
